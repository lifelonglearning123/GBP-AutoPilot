# --- LLM (OpenAI is the default; gpt-5.5) ---
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.5
# Fallback if no OpenAI key: OpenRouter
# OPENROUTER_API_KEY=sk-or-...
# LLM_MODEL=moonshotai/kimi-k2.6

# --- Citation audit (serper.dev, 2,500 free searches; ~15 searches per audit) ---
SERPER_API_KEY=...

# --- Google Business Profile ---
# Mock is opt-in: set to 1 to load two sample businesses and fake Google responses, so every
# screen and job can be exercised before API access is approved. Leave it off for real use;
# businesses added by hand, citation audits, reports and prospecting all work without Google.
# GBP_MOCK=1

# Google Cloud -> Google Auth Platform -> Clients -> Create client -> Web application
# Audience: Internal (Workspace) or External *published to production*. Redirect URI exactly:
#   http://localhost:3320/api/auth/google/callback
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
# OAUTH_REDIRECT_URI=http://localhost:3320/api/auth/google/callback
